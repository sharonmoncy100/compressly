{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "compressly.in"
        }
      ],
      "destination": "https://www.compressly.in/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/compress-image",
      "destination": "/index.html"
    },
    {
      "source": "/compress-image/",
      "destination": "/index.html"
    }
  ]
}